NODE_ENV=development
PORT=3000

# poll | worker — local default is worker; Render sets poll
BULK_MODE=worker
BULK_CONCURRENCY=10

DATABASE_URL=postgresql://courier:courier@localhost:5432/courier?schema=public&connection_limit=5
REDIS_URL=redis://localhost:6379

# Comma-separated API keys
API_KEYS=dev-key-local,oms-key-1

# Comma-separated origins for Ops UI (Vercel)
CORS_ORIGIN=http://localhost:5173,http://localhost:5174

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=60
RATE_LIMIT_BULK_MAX=10

# UrbaneBolt UAT — set password from your UAT credentials
URBANEBOLT_BASE_URL=https://uat.urbanebolt.in
URBANEBOLT_USERNAME=info@urbanebolt.com
URBANEBOLT_PASSWORD=
URBANEBOLT_CUSTOMER_CODE=UEBCUS0008
URBANEBOLT_TIMEOUT_MS=15000
URBANEBOLT_RETRY_COUNT=3
URBANEBOLT_RETRY_BASE_MS=500

# Circuit breaker (UrbaneBolt)
CIRCUIT_FAILURE_THRESHOLD=5
CIRCUIT_OPEN_MS=30000

LOG_LEVEL=info
